<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Çıkış Yap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/name_text_profile"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="Name Text"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@id/imageView2"
            app:layout_constraintTop_toTopOf="@id/imageView2"
            android:layout_marginStart="32dp" />

        <TextView
            android:id="@+id/biyografi_text_profile"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="Biografi Text"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@id/name_text_profile"
            app:layout_constraintTop_toBottomOf="@id/name_text_profile"
            android:layout_marginTop="15dp" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="151dp"
            android:layout_height="144dp"
            android:src="@drawable/outline_account_circle_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="21dp"
            android:layout_marginTop="53dp" />

        <Button
            android:id="@+id/duzenle_button_profile"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:onClick="profil_duzenle"
            android:text="Profili Düzenle"
            app:layout_constraintStart_toStartOf="@id/imageView2"
            app:layout_constraintTop_toBottomOf="@id/imageView2"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/duzenle_button_profile2"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:onClick="profil_save"
            android:text="Profili Kaydet"
            android:visibility="invisible"
            app:layout_constraintStart_toEndOf="@id/duzenle_button_profile"
            app:layout_constraintTop_toTopOf="@id/duzenle_button_profile"
            android:layout_marginStart="29dp" />

        <EditText
            android:id="@+id/editText_name"
            android:layout_width="148dp"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@id/name_text_profile"
            app:layout_constraintTop_toTopOf="@id/name_text_profile" />

        <EditText
            android:id="@+id/editText_biyografi"
            android:layout_width="148dp"
            android:layout_height="48dp"
            android:ems="10"
            android:inputType="text"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="@id/biyografi_text_profile"
            app:layout_constraintTop_toTopOf="@id/biyografi_text_profile" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
